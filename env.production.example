# BSV Micropayments API - Production Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/bsvapi
MONGODB_USER=bsvapi_user
MONGODB_PASS=your_secure_password_here

# Redis Configuration (for rate limiting and caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_here_minimum_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# BSV Network Configuration
BSV_NETWORK=mainnet
BSV_NODE_URL=https://api.bitails.io
BSV_API_KEY=your_bitails_api_key_here
BSV_MASTER_PRIVATE_KEY=your_hd_wallet_master_private_key_here
BSV_SERVICE_PRIVATE_KEY=your_service_wallet_private_key_here

# Fee Configuration
BSV_MINER_FEE=1000
BSV_SERVICE_FEE=0.01
PAYMENT_CONFIRMATION_THRESHOLD=1

# Webhook Configuration
WEBHOOK_TIMEOUT=10000
WEBHOOK_MAX_RETRIES=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Configuration
BCRYPT_ROUNDS=12
CORS_ORIGIN=https://yourdomain.com
HELMET_ENABLED=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/bsvapi/app.log

# Monitoring and Analytics
SENTRY_DSN=your_sentry_dsn_here
NEW_RELIC_LICENSE_KEY=your_new_relic_key_here

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password_here
EMAIL_FROM=noreply@yourdomain.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/var/uploads/bsvapi

# SSL/TLS Configuration (if using self-signed certificates)
SSL_KEY_PATH=/path/to/ssl/private.key
SSL_CERT_PATH=/path/to/ssl/certificate.crt

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_PATH=/var/backups/bsvapi

# Development and Testing
ENABLE_SWAGGER=false
ENABLE_DEBUG_ROUTES=false
DEMO_MODE=false

# External API Keys (for additional services)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
STRIPE_SECRET_KEY=your_stripe_key_here

# Performance Configuration
CLUSTER_MODE=true
WORKER_PROCESSES=4
MEMORY_LIMIT=512mb

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Queue Configuration (for background jobs)
REDIS_QUEUE_URL=redis://localhost:6379/1
QUEUE_CONCURRENCY=5

# WebSocket Configuration (for real-time updates)
WS_PORT=3001
WS_PATH=/ws

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Metrics and Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
PROMETHEUS_ENABLED=true

# Database Connection Pool
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=30000

# Session Configuration
SESSION_SECRET=your_session_secret_here
SESSION_MAX_AGE=86400000

# API Versioning
API_VERSION=v1
API_PREFIX=/api/v1

# Feature Flags
ENABLE_MICROPAYMENT_CHANNELS=true
ENABLE_WEBHOOKS=true
ENABLE_RATE_LIMITING=true
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true 